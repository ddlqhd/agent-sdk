{
  "name": "agent-sdk-monorepo",
  "private": true,
  "description": "Monorepo for @ddlqhd/agent-sdk, CLI, and ACP bridge",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm --filter @ddlqhd/agent-sdk dev",
    "cli": "node packages/agent-sdk-cli/bin/agent-sdk.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "pnpm --filter @ddlqhd/agent-sdk-exec build && pnpm -r --filter \"./packages/**\" --if-present run lint",
    "clean": "pnpm -r --filter \"./packages/**\" --if-present run clean",
    "build:acp": "pnpm --filter @ddlqhd/agent-sdk-acp build"
  },
  "devDependencies": {
    "@ddlqhd/agent-sdk": "workspace:*",
    "@ddlqhd/agent-sdk-cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "iconv-lite": "^0.7.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

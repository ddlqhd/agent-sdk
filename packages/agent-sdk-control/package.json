{
  "name": "@ddlqhd/agent-sdk-control",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Internal control-plane kernel for Agent SDK hosts (CLI, Web, ACP). Not a public app-server protocol.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "control-plane"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddlqhd/agent-sdk.git",
    "directory": "packages/agent-sdk-control"
  },
  "homepage": "https://github.com/ddlqhd/agent-sdk/tree/main/packages/agent-sdk-control",
  "bugs": {
    "url": "https://github.com/ddlqhd/agent-sdk/issues"
  },
  "peerDependencies": {
    "@ddlqhd/agent-sdk": ">=2.0.0"
  },
  "devDependencies": {
    "@ddlqhd/agent-sdk": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

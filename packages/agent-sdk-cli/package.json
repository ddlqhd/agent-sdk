{
  "name": "@ddlqhd/agent-sdk-cli",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "CLI for @ddlqhd/agent-sdk",
  "type": "module",
  "bin": {
    "agent-sdk": "bin/agent-sdk.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node bin/agent-sdk.mjs",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "cli",
    "agent-sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddlqhd/agent-sdk.git",
    "directory": "packages/agent-sdk-cli"
  },
  "homepage": "https://github.com/ddlqhd/agent-sdk/tree/main/packages/agent-sdk-cli",
  "bugs": {
    "url": "https://github.com/ddlqhd/agent-sdk/issues"
  },
  "dependencies": {
    "@ddlqhd/agent-sdk": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "undici": "^6.28.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.31",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
